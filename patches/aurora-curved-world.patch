+/**
+ * ac-plus: bends the world like a rolling log, after the position matrix and before the projection. A point at eye-space
+ * p goes down along up.xyz by up.w * u^2, with u = dot(p, fwd.xyz) - fwd.w. up.w = 0 is off (the default).
+ */
+void GXAuroraSetCurve(const f32 up[4], const f32 fwd[4]);
+
 /**
