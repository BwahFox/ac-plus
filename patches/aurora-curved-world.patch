@@ -91,6 +91,16 @@ void GX2SetPolygonOffset(f32 mFrontOffset, f32 mFrontScale, f32 mBackOffset, f32
   GX_WRITE_F32(mClamp);
 }
 
+void GXAuroraSetCurve(const f32 up[4], const f32 fwd[4]) {
+  GX_WRITE_AURORA(GX_AURORA_SET_CURVE);
+  for (int i = 0; i < 4; ++i) {
+    GX_WRITE_F32(up[i]);
+  }
+  for (int i = 0; i < 4; ++i) {
+    GX_WRITE_F32(fwd[i]);
+  }
+}
